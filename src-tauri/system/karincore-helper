#!/usr/bin/env python3
"""Narrow privileged boundary for KarinCore-managed configuration files."""

import json
import ipaddress
import os
import pathlib
import shutil
import subprocess
import sys
import tempfile

MAX_INPUT = 16 * 1024 * 1024
ETC_DIR = pathlib.Path("/etc/karin-proxy")


def fail(message: str) -> "None":
    print(f"karincore-helper: {message}", file=sys.stderr)
    raise SystemExit(1)


def read_input() -> bytes:
    payload = sys.stdin.buffer.read(MAX_INPUT + 1)
    if len(payload) > MAX_INPUT:
        fail("input is too large")
    return payload


def atomic_install(path: pathlib.Path, payload: bytes, mode: int = 0o600) -> None:
    path.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb") as output:
            output.write(payload)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


OPENVPN_FORBIDDEN = {
    "askpass", "auth-gen-token-secret", "auth-user-pass", "auth-user-pass-verify",
    "cd", "chroot", "client-connect", "client-crresponse",
    "client-disconnect", "config", "daemon", "down", "down-pre", "group", "ipchange",
    "engine", "http-proxy-user-pass", "ifconfig-pool-persist", "iproute",
    "learn-address", "log", "log-append", "management",
    "management-client-auth", "management-external-cert", "management-external-key",
    "management-client-group", "management-client-user", "packet-id-file", "pkcs11-providers",
    "plugin", "replay-persist", "route-pre-down", "route-up", "script-security", "secret",
    "setenv", "setenv-safe", "status", "tls-crypt-v2-verify", "tls-export-cert",
    "tls-verify", "tmp-dir", "up", "up-delay", "up-restart", "user", "writepid",
    "pkcs12",
}

OPENVPN_FILE_OPTIONS = {
    "ca", "cert", "crl-verify", "dh", "extra-certs", "key", "tls-auth",
    "tls-crypt", "tls-crypt-v2",
}


def validate_openvpn(payload: bytes) -> None:
    try:
        text = payload.decode("utf-8")
    except UnicodeDecodeError:
        fail("OpenVPN config must be UTF-8")
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith(("#", ";")):
            continue
        parts = stripped.split(None, 1)
        directive = parts[0].lower()
        if directive in OPENVPN_FORBIDDEN:
            fail(f"forbidden OpenVPN directive: {directive}")
        if directive in OPENVPN_FILE_OPTIONS:
            argument = parts[1].strip().lower() if len(parts) > 1 else ""
            if argument not in {"", "[inline]"}:
                fail(f"external OpenVPN file is forbidden: {directive}")


def validate_wireguard(payload: bytes) -> None:
    try:
        text = payload.decode("utf-8")
    except UnicodeDecodeError:
        fail("WireGuard config must be UTF-8")
    forbidden = {"preup", "postup", "predown", "postdown"}
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or "=" not in stripped:
            continue
        if stripped.split("=", 1)[0].strip().lower() in forbidden:
            fail("WireGuard command hooks are forbidden")


def walk_strings(value):
    if isinstance(value, dict):
        for nested in value.values():
            yield from walk_strings(nested)
    elif isinstance(value, list):
        for nested in value:
            yield from walk_strings(nested)
    elif isinstance(value, str):
        yield value


def reject_file_options(value) -> None:
    if isinstance(value, dict):
        for key, nested in value.items():
            normalized = key.lower()
            if normalized in {"certificatefile", "keyfile", "echconfigfile", "masterkey", "seedfile"}:
                fail(f"Xray file option is forbidden: {key}")
            reject_file_options(nested)
    elif isinstance(value, list):
        for nested in value:
            reject_file_options(nested)


def validate_xray(payload: bytes) -> None:
    try:
        config = json.loads(payload)
    except (UnicodeDecodeError, json.JSONDecodeError):
        fail("invalid Xray JSON")
    if not isinstance(config, dict):
        fail("Xray config must be an object")
    if set(config) - {"log", "dns", "routing", "inbounds", "outbounds"}:
        fail("unsupported top-level Xray option")

    log = config.get("log", {})
    if not isinstance(log, dict):
        fail("invalid Xray log section")
    for key in ("access", "error"):
        if key in log and log[key] not in {
            "/var/log/karin-proxy/access.log", "/var/log/karin-proxy/error.log"
        }:
            fail("Xray log path is outside the managed directory")

    allowed_inbounds = {"mixed", "tun", "dokodemo-door"}
    allowed_outbounds = {"vless", "vmess", "trojan", "shadowsocks", "freedom", "blackhole", "dns"}
    for inbound in config.get("inbounds", []):
        if not isinstance(inbound, dict) or inbound.get("protocol") not in allowed_inbounds:
            fail("unsupported Xray inbound")
        protocol = inbound["protocol"]
        listen = inbound.get("listen")
        if listen not in (None, "127.0.0.1", "::1"):
            fail("Xray network inbound must be loopback-only")
        allowed_ports = {
            "mixed": {2080, 2082},
            "tun": {2081},
            "dokodemo-door": {53},
        }
        if inbound.get("port") not in allowed_ports[protocol]:
            fail("unsupported Xray inbound port")
        settings = inbound.get("settings", {})
        if not isinstance(settings, dict):
            fail("invalid Xray inbound settings")
        if protocol == "tun":
            if settings.get("name") != "tun0" or settings.get("mtu") not in {1420, 1500}:
                fail("unsupported Xray TUN settings")
        if protocol == "dokodemo-door" and (
            settings.get("address") != "1.1.1.1"
            or settings.get("port") != 53
            or settings.get("network") != "udp"
        ):
            fail("unsupported Xray DNS inbound settings")
    for outbound in config.get("outbounds", []):
        if not isinstance(outbound, dict) or outbound.get("protocol") not in allowed_outbounds:
            fail("unsupported Xray outbound")

    reject_file_options(config)

    for value in walk_strings(config):
        if "\x00" in value:
            fail("NUL byte in Xray config")


def read_ip() -> str:
    try:
        value = read_input().decode("ascii").strip()
        return str(ipaddress.ip_address(value))
    except (UnicodeDecodeError, ValueError):
        fail("invalid IP address")


def main() -> None:
    if os.geteuid() != 0:
        fail("must run as root")
    if len(sys.argv) != 2:
        fail("exactly one operation is required")
    operation = sys.argv[1]
    if operation == "install-xray":
        payload = read_input()
        validate_xray(payload)
        atomic_install(ETC_DIR / "config.json", payload)
    elif operation == "install-openvpn":
        payload = read_input()
        validate_openvpn(payload)
        atomic_install(ETC_DIR / "openvpn.ovpn", payload)
    elif operation == "install-wireguard":
        payload = read_input()
        validate_wireguard(payload)
        atomic_install(ETC_DIR / "wg0.conf", payload)
    elif operation == "install-resolv":
        payload = read_input()
        if payload != b"nameserver 1.1.1.1\nnameserver 8.8.8.8\n":
            fail("unsupported resolver configuration")
        atomic_install(ETC_DIR / "resolv.conf.vpn", payload, 0o644)
    elif operation == "resolver-enable":
        source = ETC_DIR / "resolv.conf.vpn"
        if not source.is_file():
            fail("managed resolver configuration is missing")
        backup = ETC_DIR / "resolv.conf.bak"
        if not backup.exists():
            atomic_install(backup, pathlib.Path("/etc/resolv.conf").read_bytes(), 0o600)
        shutil.copyfile(source, "/etc/resolv.conf")
    elif operation == "resolver-restore":
        backup = ETC_DIR / "resolv.conf.bak"
        if backup.is_file():
            shutil.copyfile(backup, "/etc/resolv.conf")
            backup.unlink()
    elif operation == "install-geosite":
        payload = read_input()
        atomic_install(ETC_DIR / "geo/geosite.dat", payload, 0o644)
    elif operation == "install-geoip":
        payload = read_input()
        atomic_install(ETC_DIR / "geo/geoip.dat", payload, 0o644)
    elif operation == "openvpn-start":
        config = ETC_DIR / "openvpn.ovpn"
        validate_openvpn(config.read_bytes())
        os.execv("/usr/bin/openvpn", ["/usr/bin/openvpn", "--config", str(config), "--script-security", "0"])
    elif operation == "openvpn-stop":
        subprocess.run(["/usr/bin/pkill", "-f", str(ETC_DIR / "openvpn.ovpn")], check=False)
    elif operation == "wireguard-up":
        config = ETC_DIR / "wg0.conf"
        validate_wireguard(config.read_bytes())
        raise SystemExit(subprocess.run(["/usr/bin/wg-quick", "up", str(config)], check=False).returncode)
    elif operation == "wireguard-down":
        raise SystemExit(subprocess.run(["/usr/bin/wg-quick", "down", str(ETC_DIR / "wg0.conf")], check=False).returncode)
    elif operation in {"killswitch-allow", "killswitch-remove"}:
        address = read_ip()
        action = "-A" if operation == "killswitch-allow" else "-D"
        raise SystemExit(subprocess.run(
            ["/usr/bin/iptables", action, "OUTPUT", "-d", address, "-j", "ACCEPT"],
            check=False
        ).returncode)
    elif operation == "route-delete":
        address = read_ip()
        commands = [
            ["/usr/bin/ip", "rule", "del", "to", address, "lookup", "main"],
            ["/usr/bin/ip", "route", "del", address],
        ]
        if ":" not in address:
            commands.extend([
                ["/usr/bin/ip", "rule", "del", "to", f"{address}/32", "lookup", "main"],
                ["/usr/bin/ip", "route", "del", f"{address}/32"],
            ])
        for command in commands:
            subprocess.run(command, check=False)
    else:
        fail("unsupported operation")


if __name__ == "__main__":
    main()
